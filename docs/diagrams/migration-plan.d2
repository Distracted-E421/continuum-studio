}

# ============================================
# Migration Arrows
# ============================================
source.dialog_daemon -> dest_synapsix.priv: migrate {
  style: {
    stroke: "#7c3aed"
    stroke-width: 3
  }
}

source.studio_egui -> dest_studio.ui: extract & refactor {
  style: {
    stroke: "#22c55e"
    stroke-width: 2
    stroke-dash: 3
  }
}

# source.modules stays in place (no migration arrow needed)

