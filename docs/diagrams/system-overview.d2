    font-color: white
  }
  
  description: |md
    **Language**: Elixir
    **Purpose**: Harness Orchestrator
    
    • Multi-app control
    • Window automation
    • Fault tolerance
  |
  
  supervisor: Harness Supervisor
  harnesses: Harnesses {
    cursor: Cursor IDE
    android: Android Studio
    godot: Godot Editor
  }
  dialog_mgr: Dialog Manager
  core_client: Core Client
}

