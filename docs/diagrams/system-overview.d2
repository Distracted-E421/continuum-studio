# Continuum Studio - System Overview

direction: right

title: |md
  # Continuum Studio System Overview
  Complete component architecture with data flows
|

# ============================================================================
# Studio UI (Rust/egui)
# ============================================================================

studio_ui: Studio UI {
  icon: https://www.rust-lang.org/logos/rust-logo-32x32.png
  shape: rectangle
  style: {
    fill: "#2d4a6f"
    stroke: "#3b82f6"
    font-color: white
  }
  
  description: |md
    **Language**: Rust (egui/eframe)
    **Platform**: KDE/Wayland + X11
    
    • Widget-based architecture
    • VS Code theme support
    • Tabbed/tiling layout
  |
  
  widgets: Widgets {
    agent: Agent Stream
    harness: Harness Panel
    diagram: Diagram View
    code: Code View
    terminal: Terminal
  }
  
  ipc: IPC Client {
    shape: hexagon
    style.fill: "#1d4ed8"
  }
  
  dbus: D-Bus Client {
    shape: hexagon
    style.fill: "#1d4ed8"
  }
}

# ============================================================================
# Studio Core (Elixir)
# ============================================================================

studio_core: Studio Core {
  icon: https://elixir-lang.org/images/logo/logo.png
  shape: rectangle
  style: {
    fill: "#4c1d95"
    stroke: "#8b5cf6"
    font-color: white
  }
  
  description: |md
    **Language**: Elixir (BEAM)
    **Protocol**: JSON over Unix Socket
    
    • ETS-backed state
    • Event broadcasting
    • Harness coordination
  |
  
  acceptor: Socket Acceptor {
    shape: parallelogram
  }
  handler: Request Handler
  state: State (ETS) {
    shape: cylinder
  }
  event_bus: Event Bus {
    shape: queue
  }
  harness_reg: Harness Registry {
    shape: cylinder
  }
}

# ============================================================================
# Agent Bridge (Elixir)
# ============================================================================

agent_bridge: Agent Bridge {
  icon: https://elixir-lang.org/images/logo/logo.png
  shape: rectangle
  style: {
    fill: "#78350f"
    stroke: "#f59e0b"
    font-color: white
  }
  
  description: |md
    **Language**: Elixir
    **Purpose**: Unified AI Interface
    
    • Multi-provider support
    • Context management
    • Cost tracking
    • Rate limiting
  |
  
  router: Router
  providers: Provider Registry {
    shape: cylinder
  }
  context: Context Manager
  cost: Cost Tracker
  rate: Rate Limiter
  middleware: Middleware {
    shape: queue
  }
}

