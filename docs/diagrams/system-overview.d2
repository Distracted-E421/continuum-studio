# ============================================================================
# Data Flows
# ============================================================================

# UI to Core
studio_ui.ipc -> studio_core.acceptor: JSON (Unix Socket) {
  style.stroke: "#6366f1"
  style.stroke-width: 2
}

# UI to Dialog
studio_ui.dbus -> dialog.dbus_if: D-Bus {
  style.stroke: "#eab308"
}

# Core internal flows
studio_core.acceptor -> studio_core.handler
studio_core.handler -> studio_core.state
studio_core.handler -> studio_core.event_bus
studio_core.handler -> studio_core.harness_reg

# Core to Agent Bridge
studio_core.event_bus -> agent_bridge.router: agent requests {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}
agent_bridge.router -> studio_core.event_bus: agent responses {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

# Agent Bridge to Providers
agent_bridge.providers -> providers.claude: HTTPS {
  style.stroke: "#8b5cf6"
}
agent_bridge.providers -> providers.ollama: HTTP {
  style.stroke: "#22c55e"
}
agent_bridge.providers -> synapsix.harnesses.cursor: via harness {
  style.stroke: "#3b82f6"
  style.stroke-dash: 3
}

# Synapsix to Core
synapsix.core_client -> studio_core.acceptor: JSON (Unix Socket) {
  style.stroke: "#dc2626"
}
studio_core.harness_reg -> synapsix.supervisor: control commands {
  style.stroke: "#dc2626"
}

# Synapsix to Dialog
synapsix.dialog_mgr -> dialog.dbus_if: D-Bus {
  style.stroke: "#eab308"
}

# Harnesses to Applications
synapsix.harnesses.cursor -> apps.cursor_app: kdotool/ydotool {
  style.stroke: "#06b6d4"
  style.stroke-dash: 3
}
synapsix.harnesses.android -> apps.android_app: automation {
  style.stroke: "#22c55e"
  style.stroke-dash: 3
}
synapsix.harnesses.godot -> apps.godot_app: automation {
  style.stroke: "#3b82f6"
  style.stroke-dash: 3
}

# Provider to Cursor AI (via app)
providers.cursor_ai -> apps.cursor_app: built-in AI {
  style.stroke: "#3b82f6"
  style.stroke-dash: 3
}

