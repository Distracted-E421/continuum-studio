<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for WebSocket -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice input for XR mode -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Keep screen on during dialogs -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Media and notification access -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- Shizuku: lets the app run ADB-shell commands (UID 2000) without root.
         Used for MultiSound control and TAKE_AUDIO_FOCUS appops. The user must
         grant this inside the Shizuku app after installing. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Foreground service for background notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required on Android 14+ for any service declaring
         foregroundServiceType="mediaPlayback". Without it the media session
         service fails to start, the session dies, and Android Auto drops the
         audio route back to the car's own tuner. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Camera and gallery permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- OTA update installation -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Location permissions for navigation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ContinuumStudio">

        <!-- Android Auto support (notification-based messaging) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ContinuumStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for dialog notifications -->
        <service
            android:name=".service.DialogNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Foreground service for persistent XR glasses display -->
        <service
            android:name=".service.GlassesDisplayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains XR glasses display when app is backgrounded" />
        </service>

        <!-- Foreground service for Cognix nudge delivery -->
        <service
            android:name=".service.CognixPushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Orchestrator homescreen widget -->
        <receiver
            android:name=".widget.OrchestratorWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/orchestrator_widget_info" />
        </receiver>
        <!-- Now Playing service for media control -->
        <service
            android:name=".service.NowPlayingService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Google Maps API Key - Replace with your key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- FileProvider for APK installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- OTA Update install receiver -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Android Auto reply handling service -->
        <service
            android:name=".service.AutoReplyService"
            android:exported="false" />

        <!-- Gemini Accessibility Service for Project Ouroboros -->
        <service
            android:name=".service.GeminiAccessibilityService"
            android:exported="true"
            android:label="@string/gemini_accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gemini_accessibility_service_config" />
        </service>

        <!-- Shizuku attaches its binder through this provider. Without it the
             Shizuku API silently fails: no binder is ever received, so
             permission requests go nowhere and pingBinder() stays false. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Owns a MediaSession. NOT exported and no longer advertised to Android
             Auto.

             It used to be exported with the media3/MediaBrowser intent filters so
             AA could discover it. That made Continuum a discoverable media source
             on the head unit, which in practice meant the car attached to a source
             that played nothing: no audio from any app, and the head unit's own
             volume overlay stopped appearing (Subaru, 2026-11-18).

             The automotive descriptor no longer declares `media` either, so AA has
             no reason to look for this. In-app binding still works - a
             SessionToken targets this component explicitly and does not need
             intent filters - and dialog speech goes through the phone's normal
             media route instead.

             If head-unit playback is ever wanted again, it must be an explicit
             opt-in with a session that exists only for the duration of a read. -->
        <service
            android:name=".service.DialogMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Boot receiver keeps the media session available so Android Auto
             always finds a media source when the car connects. -->
        <receiver
            android:name=".service.MediaBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>