<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility Service configuration for Gemini capture.
  Part of Project Ouroboros.

  Permissions required:
  - canRetrieveWindowContent: Read text from Gemini app
  - packageNames: Only listen to Gemini/NotebookLM
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/gemini_accessibility_description"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.apps.bard,com.google.android.apps.notebooklm"
    android:settingsActivity="com.example.continuumstudio.MainActivity" />
