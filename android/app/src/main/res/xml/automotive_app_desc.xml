<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto application descriptor.

    `media` is what lets the head unit talk to DialogMediaService. Without it
    Android Auto never queries our MediaSession, so the audio route is never
    held by us and the car falls back to its own radio.

    `notification` keeps the MessagingStyle dialog notifications working.
-->
<automotiveApp>
    <uses name="media" />
    <uses name="notification" />
</automotiveApp>
