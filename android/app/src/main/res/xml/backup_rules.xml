<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API < 31, where `data_extraction_rules.xml` is ignored.

   Kept in sync with that file. Excluded:

   - `datastore/settings.preferences_pb` and `app_settings.preferences_pb`: these hold the
     Cloudflare Access client secret. A credential must not go to a cloud backup.
   - `incidents/` and `reports/`: diagnostics containing device names and audio routing.

   Everything else is still backed up, including `offline_queue` and `dialog_history`,
   which are user work.

   These paths are literal because backup rules do not support wildcards. Renaming a
   DataStore requires renaming its exclusion here, or the credential silently starts
   being backed up again.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="file" path="datastore/app_settings.preferences_pb" />
    <exclude domain="file" path="incidents/" />
    <exclude domain="file" path="reports/" />
    <exclude domain="external" path="reports/" />
</full-backup-content>
