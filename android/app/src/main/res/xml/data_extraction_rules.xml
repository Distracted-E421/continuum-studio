<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules.

   The app has `allowBackup="true"`, so by default everything in the app's files dir and
   its DataStores is uploaded to the user's cloud backup. Two categories are excluded.

   1. CREDENTIALS. `datastore/settings.preferences_pb` holds the Cloudflare Access client
      secret and the endpoint list; `app_settings` holds an earlier copy of the same
      fields. A credential must not be replicated to a third-party backup service, and it
      is not needed there - the user re-enters it on a new device.

   2. DIAGNOSTICS. `incidents/` (written automatically on every dialog read) and
      `reports/` (written on demand) contain device names, audio routing and dialog
      titles. They are meant to be read on the device and pasted deliberately.

   Everything else still backs up. In particular `offline_queue` (queued answers) and
   `dialog_history` are user work and must survive a device migration.

   ## Maintenance

   Backup rules do not support wildcards, so these paths are literal. If a DataStore is
   renamed, the matching exclusion must be renamed here too - otherwise the credential
   silently starts being backed up again while this file still looks correct. The
   `preferences_pb` suffix is the DataStore library's own convention (present in
   `datastore-preferences-core`), not an assumption.

   API < 31 uses `backup_rules.xml`; both files are kept in sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
        <exclude domain="file" path="incidents/" />
        <exclude domain="file" path="reports/" />
        <exclude domain="external" path="reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
        <exclude domain="file" path="incidents/" />
        <exclude domain="file" path="reports/" />
        <exclude domain="external" path="reports/" />
    </device-transfer>
</data-extraction-rules>
